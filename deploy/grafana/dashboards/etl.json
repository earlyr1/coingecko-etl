{
  "uid": "coingecko-etl",
  "title": "CoinGecko ETL",
  "tags": ["etl", "coingecko"],
  "timezone": "utc",
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "graphTooltip": 1,
  "refresh": "15s",
  "time": {"from": "now-1h", "to": "now"},
  "timepicker": {},
  "templating": {"list": []},
  "annotations": {"list": []},
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Data freshness",
      "description": "Seconds since the last successful markets poll (alert at 120 s).",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 0, "y": 0, "w": 6, "h": 4},
      "fieldConfig": {"defaults": {"unit": "s", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 60}, {"color": "red", "value": 120}]}, "color": {"mode": "thresholds"}}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "colorMode": "value", "graphMode": "area", "textMode": "auto", "justifyMode": "auto", "orientation": "auto"},
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "refId": "A", "expr": "time() - max(etl_last_success_timestamp_seconds{endpoint=\"coins_markets\"})", "instant": false}
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Duplicate share (1h)",
      "description": "Records dropped by dedup / (dropped + written) over the last hour. Markets responses repeat (the CDN serves the same snapshot for 60 s and we poll every 30 s) while coin-detail records rarely do, so roughly 20-25% is normal.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 6, "y": 0, "w": 6, "h": 4},
      "fieldConfig": {"defaults": {"unit": "percentunit", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]}, "color": {"mode": "thresholds"}, "decimals": 1}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "colorMode": "value", "graphMode": "area", "textMode": "auto", "justifyMode": "auto", "orientation": "auto"},
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "refId": "A", "expr": "sum(increase(etl_dedup_dropped_total[1h])) / (sum(increase(etl_dedup_dropped_total[1h])) + sum(increase(etl_records_total{outcome=\"written\"}[1h])))", "instant": false}
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "DLQ records (24h)",
      "description": "Records the exporter and the transformers sent to the dead-letter zone in the last 24 hours; anything above 0 needs a human. Lines the publish job sends to dlq/stage=publish are in Published per window.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 12, "y": 0, "w": 6, "h": 4},
      "fieldConfig": {"defaults": {"unit": "short", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]}, "color": {"mode": "thresholds"}}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "colorMode": "value", "graphMode": "area", "textMode": "auto", "justifyMode": "auto", "orientation": "auto"},
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "refId": "A", "expr": "sum(increase(etl_dlq_total[24h])) or vector(0)", "instant": false}
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "End-to-end latency p95",
      "description": "95th percentile from fetched_at to the processed object being written (15 min window).",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 18, "y": 0, "w": 6, "h": 4},
      "fieldConfig": {"defaults": {"unit": "s", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]}, "color": {"mode": "thresholds"}}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "colorMode": "value", "graphMode": "area", "textMode": "auto", "justifyMode": "auto", "orientation": "auto"},
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "refId": "A", "expr": "histogram_quantile(0.95, sum by (le) (rate(etl_e2e_latency_seconds_bucket[15m])))", "instant": false}
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Records per stage",
      "description": "Throughput of the continuous hops: CoinGecko calls stored and processed records by outcome. The publisher runs once per window; see Published per window.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 0, "y": 4, "w": 24, "h": 8},
      "fieldConfig": {"defaults": {"unit": "short", "custom": {"drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "showPoints": "never", "spanNulls": false}}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "refId": "A", "expr": "sum(rate(etl_api_requests_total{status=\"200\"}[5m])) * 60", "legendFormat": "fetched calls / min"},
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "refId": "C", "expr": "sum by (outcome) (rate(etl_records_total[5m])) * 60", "legendFormat": "transformer {{outcome}} / min"}
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Data freshness and source age",
      "description": "Seconds since the last successful call per endpoint, and how old CoinGecko's own data was when fetched (fetched_at - last_updated).",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 0, "y": 12, "w": 12, "h": 8},
      "fieldConfig": {"defaults": {"unit": "s", "custom": {"drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "showPoints": "never", "spanNulls": false}}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "refId": "A", "expr": "time() - etl_last_success_timestamp_seconds", "legendFormat": "since last success: {{endpoint}}"},
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "refId": "B", "expr": "etl_source_data_age_seconds", "legendFormat": "source data age: {{endpoint}}"}
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "End-to-end latency",
      "description": "From fetched_at to the processed object: includes the wait for the window to close (up to ETL_WINDOW) and the one-minute publish grace.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 12, "y": 12, "w": 12, "h": 8},
      "fieldConfig": {"defaults": {"unit": "s", "custom": {"drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "showPoints": "never", "spanNulls": false}}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "refId": "A", "expr": "histogram_quantile(0.5, sum by (le) (rate(etl_e2e_latency_seconds_bucket[5m])))", "legendFormat": "p50"},
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "refId": "B", "expr": "histogram_quantile(0.95, sum by (le) (rate(etl_e2e_latency_seconds_bucket[5m])))", "legendFormat": "p95"},
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "refId": "C", "expr": "histogram_quantile(0.99, sum by (le) (rate(etl_e2e_latency_seconds_bucket[5m])))", "legendFormat": "p99"}
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Duplicate share",
      "description": "Share of records dropped by deduplication, total and by reason (replay = the same message published twice, duplicate_response = a byte-identical API response from another poll, duplicate_record = the same content from another response).",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 0, "y": 20, "w": 12, "h": 8},
      "fieldConfig": {"defaults": {"unit": "percentunit", "custom": {"drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "showPoints": "never", "spanNulls": false}}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "refId": "A", "expr": "sum(rate(etl_dedup_dropped_total[15m])) / (sum(rate(etl_dedup_dropped_total[15m])) + sum(rate(etl_records_total{outcome=\"written\"}[15m])))", "legendFormat": "total"},
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "refId": "B", "expr": "sum by (reason) (rate(etl_dedup_dropped_total[15m])) / ignoring(reason) group_left() (sum(rate(etl_dedup_dropped_total[15m])) + sum(rate(etl_records_total{outcome=\"written\"}[15m])))", "legendFormat": "{{reason}}"}
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Rejected records by reason",
      "description": "Cleaning-rule drops written to the rejected zone (missing_id, null_price, nonpositive_price, empty_platform, empty_record, snapshot_conflict).",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 12, "y": 20, "w": 12, "h": 8},
      "fieldConfig": {"defaults": {"unit": "short", "custom": {"drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "showPoints": "never", "spanNulls": false, "stacking": {"mode": "normal", "group": "A"}}}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "refId": "A", "expr": "sum by (reason) (increase(etl_rejected_total[15m]))", "legendFormat": "{{reason}}"}
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Dead-letter records",
      "description": "Records written to the dlq zone in the last 15 minutes: the total, 0 when nothing was dead-lettered (the normal state), and the breakdown by stage and error class (export and transform stages; the publish job's DLQ lines are in Published per window).",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 0, "y": 28, "w": 12, "h": 8},
      "fieldConfig": {"defaults": {"unit": "short", "custom": {"drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "showPoints": "never", "spanNulls": false, "stacking": {"mode": "normal", "group": "A"}}}, "overrides": [{"matcher": {"id": "byName", "options": "total"}, "properties": [{"id": "custom.stacking", "value": {"mode": "none", "group": "A"}}, {"id": "custom.fillOpacity", "value": 0}]}]},
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "refId": "A", "expr": "sum by (stage, error_class) (increase(etl_dlq_total[15m]))", "legendFormat": "{{stage}} / {{error_class}}"},
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "refId": "B", "expr": "sum(increase(etl_dlq_total[15m])) or vector(0)", "legendFormat": "total"}
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Consumer lag",
      "description": "High watermark minus the next offset to process (the committed position) per partition, summed over transformer replicas.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 12, "y": 28, "w": 12, "h": 8},
      "fieldConfig": {"defaults": {"unit": "short", "custom": {"drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "showPoints": "never", "spanNulls": false}}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "refId": "A", "expr": "sum by (partition) (etl_consumer_lag_records)", "legendFormat": "partition {{partition}}"},
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "refId": "B", "expr": "sum(etl_consumer_lag_records)", "legendFormat": "total"}
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "CoinGecko API status codes",
      "description": "Calls per minute by endpoint and HTTP status: 429 = rate limited, network_error, skipped = tick skipped (limiter cooldown or a request still in flight).",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 0, "y": 36, "w": 8, "h": 8},
      "fieldConfig": {"defaults": {"unit": "short", "custom": {"drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "showPoints": "never", "spanNulls": false, "stacking": {"mode": "normal", "group": "A"}}}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "refId": "A", "expr": "sum by (endpoint, status) (rate(etl_api_requests_total[5m])) * 60", "legendFormat": "{{endpoint}} {{status}}"}
      ]
    },
    {
      "id": 19,
      "type": "timeseries",
      "title": "CoinGecko API latency",
      "description": "p50 and p95 of the CoinGecko call latency by endpoint over 5 minutes, from sending the request to the end of the body read, for every call that got a complete HTTP response (network errors, a failed body read or a timeout among them, are not timed). Under a second is normal; the client gives up at 10 s.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 8, "y": 36, "w": 8, "h": 8},
      "fieldConfig": {"defaults": {"unit": "s", "custom": {"drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "showPoints": "never", "spanNulls": false}}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "refId": "A", "expr": "histogram_quantile(0.5, sum by (endpoint, le) (rate(etl_api_request_duration_seconds_bucket[5m])))", "legendFormat": "{{endpoint}} p50"},
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "refId": "B", "expr": "histogram_quantile(0.95, sum by (endpoint, le) (rate(etl_api_request_duration_seconds_bucket[5m])))", "legendFormat": "{{endpoint}} p95"}
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Export lag and S3 writes",
      "description": "How far the exporter is behind closing raw windows (0 on schedule), and conditional S3 PUT results (exists = idempotent retry, mismatch = alert).",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 16, "y": 36, "w": 8, "h": 8},
      "fieldConfig": {"defaults": {"unit": "short", "custom": {"drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "showPoints": "never", "spanNulls": false}}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "refId": "A", "expr": "max(etl_export_lag_seconds)", "legendFormat": "export lag (s)"},
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "refId": "B", "expr": "sum by (result) (rate(etl_s3_put_total[5m])) * 60", "legendFormat": "s3 put {{result}} / min"}
      ]
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Schema validations",
      "description": "Validations per minute by stage, schema and result.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 0, "y": 44, "w": 24, "h": 8},
      "fieldConfig": {"defaults": {"unit": "short", "custom": {"drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "showPoints": "never", "spanNulls": false}}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "refId": "A", "expr": "sum by (stage, schema, result) (rate(etl_schema_validations_total[5m])) * 60", "legendFormat": "{{stage}} {{schema}} {{result}}"}
      ]
    },
    {
      "id": 15,
      "type": "stat",
      "title": "Batch jobs: since last success",
      "description": "Seconds since each Cronicle job (etl publish, retention, vacuum) last pushed a success to the Pushgateway. ETLPublisherStale fires above 15 minutes, ETLMaintenanceStale above 26 hours.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 0, "y": 52, "w": 8, "h": 8},
      "fieldConfig": {"defaults": {"unit": "s", "decimals": 0, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]}, "color": {"mode": "thresholds"}}, "overrides": [{"matcher": {"id": "byName", "options": "etl_publisher"}, "properties": [{"id": "thresholds", "value": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 600}, {"color": "red", "value": 900}]}}]}]},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "colorMode": "background", "graphMode": "none", "textMode": "value_and_name", "justifyMode": "auto", "orientation": "horizontal"},
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "refId": "A", "expr": "time() - max by (job) (etl_job_last_success_timestamp_seconds)", "legendFormat": "{{job}}", "instant": false}
      ]
    },
    {
      "id": 20,
      "type": "stat",
      "title": "Batch jobs: since last run",
      "description": "Seconds since each Cronicle job (etl publish, retention, vacuum) last pushed a run to the Pushgateway, failed runs included. Read it next to Batch jobs: since last success: both small means the job runs and succeeds, a small last run with a large last success means it runs and fails, both large means it does not run (check Cronicle). etl publish runs every ETL_WINDOW, retention and vacuum once a day.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 8, "y": 52, "w": 8, "h": 8},
      "fieldConfig": {"defaults": {"unit": "s", "decimals": 0, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]}, "color": {"mode": "thresholds"}}, "overrides": [{"matcher": {"id": "byName", "options": "etl_publisher"}, "properties": [{"id": "thresholds", "value": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 600}, {"color": "red", "value": 900}]}}]}]},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "colorMode": "background", "graphMode": "none", "textMode": "value_and_name", "justifyMode": "auto", "orientation": "horizontal"},
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "refId": "A", "expr": "time() - max by (job) (etl_job_last_run_timestamp_seconds)", "legendFormat": "{{job}}", "instant": false}
      ]
    },
    {
      "id": 16,
      "type": "timeseries",
      "title": "Published per window",
      "description": "Records the last successful etl publish run produced to the broker and the lines it sent to dlq/stage=publish (pushed gauges: the value holds until the next successful run).",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 16, "y": 52, "w": 8, "h": 8},
      "fieldConfig": {"defaults": {"unit": "short", "custom": {"drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "showPoints": "never", "spanNulls": false, "lineInterpolation": "stepAfter"}}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "refId": "A", "expr": "max(etl_publish_records{job=\"etl_publisher\"})", "legendFormat": "published records"},
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "refId": "B", "expr": "max(etl_publish_dlq_lines{job=\"etl_publisher\"})", "legendFormat": "dlq lines"}
      ]
    },
    {
      "id": 17,
      "type": "timeseries",
      "title": "Batch job runs",
      "description": "Duration and result (1 = success, 0 = failure) of the last run of each Cronicle job.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 0, "y": 60, "w": 12, "h": 8},
      "fieldConfig": {"defaults": {"unit": "short", "custom": {"drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "showPoints": "never", "spanNulls": false, "lineInterpolation": "stepAfter"}}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "refId": "A", "expr": "max by (job) (etl_job_duration_seconds)", "legendFormat": "{{job}} duration (s)"},
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "refId": "B", "expr": "max by (job) (etl_job_success)", "legendFormat": "{{job}} success"}
      ]
    },
    {
      "id": 18,
      "type": "timeseries",
      "title": "Retention",
      "description": "What the last etl maintenance retention run removed.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 12, "y": 60, "w": 12, "h": 8},
      "fieldConfig": {"defaults": {"unit": "short", "custom": {"drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "showPoints": "never", "spanNulls": false, "lineInterpolation": "stepAfter"}}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "refId": "A", "expr": "max(etl_retention_partitions_dropped{job=\"etl_retention\"})", "legendFormat": "dedup claim partitions dropped"},
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "refId": "B", "expr": "max(etl_retention_batches_deleted{job=\"etl_retention\"})", "legendFormat": "written consumer batches deleted"}
      ]
    }
  ]
}
