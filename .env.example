# Copy to .env (`make up` does it for you) and adjust as needed.

# Optional CoinGecko Demo API key (sent as x-cg-demo-api-key). Keyless works
# at the default request budget (~4 calls/min).
COINGECKO_API_KEY=

# Host user that owns ./data, ./logs and ./.s3meta. `make up` writes the
# current user's ids here when it creates .env from this file (and passes them
# to compose); set them yourself when you create .env by hand on Linux.
ETL_UID=65532
ETL_GID=65532

# Host ports (bound to 127.0.0.1).
POSTGRES_PORT=5432
REDPANDA_EXTERNAL_PORT=19092
S3_PORT=7070
CONSOLE_PORT=8081
PROMETHEUS_PORT=9090
PUSHGATEWAY_PORT=9091
GRAFANA_PORT=3000
CRONICLE_PORT=3012

# Object storage credentials (versitygw root account).
ETL_S3_ACCESS_KEY=etl
ETL_S3_SECRET_KEY=etlsecret123

# Polling and pipeline tuning (Go durations).
ETL_MARKETS_INTERVAL=30s
ETL_DETAIL_INTERVAL=30s
ETL_DETAIL_OFFSET=15s
ETL_WATCHLIST=bitcoin,ethereum,tether,usd-coin
ETL_MIN_REQUEST_SPACING=15s
# Exporter tick; must be shorter than 1m, the publisher's grace after a window end.
ETL_EXPORT_INTERVAL=15s
# Width of an export/publish window (raw/.../window=HHMM/). Whole minutes that
# divide an hour: 1m 2m 3m 4m 5m 6m 10m 12m 15m 20m 30m 60m. Cronicle runs
# etl publish one minute after every window end; make demo overrides it with
# 1m. It can be changed on a running stack (make up recreates every etl
# container and cronicle with the host user ids): the exporter switches at the
# next boundary of the new size and loses no row, but a window of the old size
# published after the switch gets no scheduled run; publish it by hand with its
# own size (README, "Changing ETL_WINDOW").
ETL_WINDOW=5m
# Days of dedup claims (and written transformer batch rows) kept by
# `etl maintenance retention`. At least the topic retention in days + 1.
ETL_CLAIMS_RETENTION_DAYS=8

# Cleaning thresholds (spec §6.4).
ETL_STALE_AFTER=10m
ETL_TICKER_STALE_AFTER=1h
ETL_TICKER_ANOMALY_PCT=2.0
# market_snapshot.is_anomaly: percent of tolerance around [low_24h, high_24h]
# (precision=full prices carry more digits than the rounded bounds); 0 = strict.
ETL_ANOMALY_TOLERANCE_PCT=0.5

GRAFANA_ADMIN_PASSWORD=admin

# Cronicle (UI at http://localhost:$CRONICLE_PORT). Time zone of the daily
# maintenance jobs (retention 11:00, vacuum 11:30); etl publish always runs
# on the UTC window grid.
ETL_SCHEDULE_TZ=UTC
# Login admin / CRONICLE_ADMIN_PASSWORD, and the API key the container uses to
# create its events. Both are stored when the cronicle volume is first
# created; editing them here later has no effect (how to change them:
# README, "Scheduled jobs").
CRONICLE_ADMIN_PASSWORD=admin
CRONICLE_API_KEY=etl_local_dev_api_key_0001
# Optional job notification URL (Slack-compatible incoming web hook); empty = off.
CRONICLE_WEB_HOOK=
